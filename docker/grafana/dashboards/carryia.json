{
  "uid": "carryia-monitoring",
  "title": "Carryia Monitoring",
  "tags": [
    "carryia",
    "p0-8"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total LLM answers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"answers\" FROM conversations WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg response time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(response_time_ms) AS \"avg_ms\" FROM conversations WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total cost (answer + judge)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd + eval_cost_usd), 0) AS \"usd\" FROM conversations WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg tokens / answer",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(total_tokens) AS \"avg_tokens\" FROM conversations WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost over time (answer + judge)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", (cost_usd + eval_cost_usd) AS \"cost\" FROM conversations WHERE $__timeFilter(created_at) ORDER BY created_at",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", response_time_ms FROM conversations WHERE $__timeFilter(created_at) ORDER BY created_at",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Answer relevance (LLM-as-judge)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "pie",
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RELEVANT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PARTLY_RELEVANT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "NON_RELEVANT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE relevance = 'RELEVANT') AS \"RELEVANT\", count(*) FILTER (WHERE relevance = 'PARTLY_RELEVANT') AS \"PARTLY_RELEVANT\", count(*) FILTER (WHERE relevance = 'NON_RELEVANT') AS \"NON_RELEVANT\" FROM conversations WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Feedback (thumbs)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "carryia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "pie",
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE rating > 0) AS \"up\", count(*) FILTER (WHERE rating <= 0) AS \"down\" FROM feedback WHERE $__timeFilter(created_at)",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "carryia-postgres"
          }
        }
      ]
    }
  ]
}