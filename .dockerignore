# Keep the build context small and the image runtime-only.
.git
.gitignore
.venv
.env
**/__pycache__
*.pyc
.pytest_cache
carryia.egg-info

# Build/eval artifacts and raw payloads -- not part of the runtime image. The Dockerfile
# COPYs only the three committed files the app reads (corpus, snapshot, cohort); this
# keeps the 1.1 GB data/raw tree out of the build context entirely.
data/raw
data/drafts
data/clean
data/eval
data/ground_truth.jsonl
data/feedback.jsonl

# Not needed at runtime.
tests
docs
*.log
