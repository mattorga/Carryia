# Carryia -- environment configuration. Copy to .env and fill in your own key(s).
# The real .env is gitignored; reviewers bring their own credentials.

# --- LLM backend -------------------------------------------------------------
# Which backend the answer generator + the P0-6 judge run on:
#   anthropic  (default) -- the direct Claude API; reviewers use this path.
#   bedrock              -- Amazon Bedrock, billed to AWS (the builder's eval switch).
CARRYIA_LLM_BACKEND=anthropic

# --- Direct Anthropic API (CARRYIA_LLM_BACKEND=anthropic) ---------------------
# Get a key at https://console.anthropic.com/ . Cheap model (Haiku 4.5) is pinned.
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon Bedrock (CARRYIA_LLM_BACKEND=bedrock) -----------------------------
# A Bedrock API key (bearer token): AWS console > Bedrock > API keys. Requires
# Anthropic model access enabled in the Bedrock console for AWS_REGION.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2

# --- Optional model-id overrides (defaults are Haiku 4.5) --------------------
# CARRYIA_MODEL=claude-haiku-4-5
# CARRYIA_BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Monitoring database (P0-8) ----------------------------------------------
# Under `docker compose up` this is injected automatically (the app talks to the
# Postgres service), so you do NOT need to set it. Only set it for a local
# `streamlit run` where you want monitoring on against your own Postgres; leave it
# unset and the app still answers -- monitoring is simply off, no DB required.
# DATABASE_URL=postgresql://carryia:carryia@localhost:5432/carryia
#
# Grafana runs at http://localhost:3000 (admin / admin) once the stack is up.
